{
  "name": "haltest",
  "version": "1.0.12",
  "description": "CLI launcher for the HalTest browser automation & orchestration platform",
  "main": "bin/haltest.js",
  "type": "module",
  "bin": {
    "haltest": "bin/haltest.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/haltest.js",
    "dev": "node bin/haltest.js",
    "stop": "fuser -k 2001/tcp || true",
    "cli": "node src/index.js",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.1",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "socket.io-client": "^4.8.3",
    "terminal-image": "^4.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": false
}
