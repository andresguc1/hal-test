    },
    {
      "type": "chain_of_thought",
      "category": "llm_ai",
      "label": "Chain of Thought",
      "description": "Step-by-step reasoning with AI",
      "color": "violet",
      "icon": "Brain",
      "version": "1.0.0",
      "schema": "./schemas/chain_of_thought.js",
      "handler": "./handlers/chain_of_thought.js"
    },
    {
      "type": "smart_selector",
      "category": "llm_ai",
      "label": "Smart Selector",
      "description": "Suggest CSS/Playwright selectors using AI",
      "color": "violet",
      "icon": "Brain",
      "version": "1.0.0",
      "schema": "./schemas/smart_selector.js",
      "handler": "./handlers/smart_selector.js"
