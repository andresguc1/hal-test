{
  "name": "@halt-test/backend",
  "version": "1.0.0",
  "description": "Backend for the HalTest project",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=controllers --watch-path=services --watch-path=middlewares --watch-path=routes --watch-path=database --watch-path=schemas --watch app.js",
    "start": "node app.js",
    "stop": "fuser -k 2001/tcp || true",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\" \"!node_modules/**\"",
    "clean": "rm -rf node_modules",
    "prepare": "husky",
    "db:init": "node database/init.js",
    "postinstall": "playwright install chromium firefox webkit"
  },
  "keywords": [],
  "author": "andresguc <andresguc@gmail.com>",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/USER_NAME/halt-test.git",
    "directory": "apps/backend"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.90.1",
    "ai": "^6.0.3",
    "chalk": "^5.4.1",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.2",
    "filbert": "^0.1.20",
    "hdr-histogram-js": "^3.0.1",
    "helmet": "^8.1.0",
    "i18next": "^25.7.3",
    "i18next-http-middleware": "^3.9.7",
    "joi": "^18.2.1",
    "joi-to-swagger": "^6.2.0",
    "lib0": "^0.2.117",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "playwright": "^1.62.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.1",
    "y-leveldb": "^0.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.38.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.js": [
      "npm run format",
      "npm run lint:fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}