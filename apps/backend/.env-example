PORT=2001
# OPENAI_API_KEY=
AUTH_ENABLED=false

# Optional: only needed to enable real authentication (cloud mode).
# When unset, the app runs in guest mode automatically.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# HALTEST_MASTER_ENCRYPTION_KEY=

# TollAI (bot/AI-agent defense). TOLLAI_SECRET is REQUIRED when NODE_ENV=production;
# in development an ephemeral key is generated automatically.
# TOLLAI_SECRET=
# TOLLAI_POW_DIFFICULTY=12
# TOLLAI_MIN_DWELL_MS=1500
